#!/usr/bin/env bash
# Live performance tooling for React Native release builds and React web apps. Lives outside the
# project: a probe build is assembled from this folder on request and leaves the project untouched.
#
# Run from inside the project (or set PERF_REPO=/path/to/project). The project's settings come
# from the setup page (perf init / the Perf Tool app), saved in ~/.config/perf-tool/projects.json.
#   perf init                            Setup page: scan the project, fill in or fix the settings
#   perf ios ["<device or simulator>"] [--variant <name>] [--team ID]
#                                        Server + Release build with probe + install + dashboard
#                                        (no device name: pick from a list; outside a
#                                        terminal the one iPhone connected by cable)
#   perf android [serial|address] [--variant <name>] [--cable]
#                                        Server + Android release with probe + install + dashboard,
#                                        over adb on Wi-Fi (no serial: pick from a list; a phone on
#                                        the cable is switched to Wi-Fi unless --cable)
#   perf web [chrome|android|none] [--variant <name>] [--port N]
#                                        React web app: production build + probe on the app's port
#                                        (no --variant: pick from a list, default = production),
#                                        dashboard, and Chrome on this Mac (android: Chrome on the phone
#                                        connected by USB; none: open it yourself — Safari, a phone on the
#                                        same Wi-Fi). Outside a project the dashboard asks for one.
#   perf health [--json]                 Code health: leaks, selectors, circular imports, CSS, packages
#   perf setup [--remove]                Add (or remove) the yarn perf:* scripts in package.json
#   perf devices                         List iOS devices/simulators and Android devices
#   perf server [android]                Only the live dashboard (http://localhost:8099)
#   perf compiler [path-filter] [--all]  React Compiler status per component
#   perf ios-trace <label> "<device>" [seconds]   Instruments recording + summary
#   perf ios-compare <before.json> <after.json>
#   perf update                          Update perf-tool from its git repository
#   perf clean                           Remove generated files and probe build caches
#
# --variant picks a domain / brand of a multi-domain project (--brand is the same); without it
# the default one is built. Add --no-server to `perf ios|android` to only build and install.
# --repo <path> runs for that project instead of the current folder.
set -euo pipefail

TOOL="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# The Perf Tool app links its built-in Node here; otherwise the system Node runs the tool.
if [[ -x "$TOOL/runtime/node" ]]; then NODE="$TOOL/runtime/node"; else NODE="$(command -v node || echo node)"; fi
RESULTS_DIR="$HOME/perf-results"
PORT=8099
DASHBOARD="http://localhost:$PORT"
SERVER_PID=""
TAIL_PID=""
DEV_PID=""

# The project perf works on and the folders derived from its name.
use_repo() {
  REPO="$(cd "$1" 2>/dev/null && pwd)" || { echo "perf: folder not found: $1" >&2; exit 1; }
  NAME="$(basename "$REPO")"
  GEN="$TOOL/.generated/$NAME"
  CACHE="$HOME/Library/Caches/perf-tool/$NAME"
}
use_repo "${PERF_REPO:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}"

usage() { sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | grep '^#' | sed 's/^# \{0,1\}//'; }
fail() { echo "perf: $*" >&2; exit 1; }

require() {
  [[ -x "$NODE" ]] || command -v "$NODE" >/dev/null 2>&1 || fail "Node.js is required (or install the Perf Tool app, which has it built in)"
  for tool in "$@"; do
    command -v "$tool" >/dev/null 2>&1 || fail "'$tool' is required but not installed (see README)"
  done
}

check_project() {
  [[ -f "$REPO/package.json" ]] || fail "run perf from the project folder (no package.json in $REPO), or set PERF_REPO"
  [[ -d "$REPO/node_modules" ]] || fail "node_modules missing in $REPO — run 'yarn install' (or npm install) first"
}

# Settings of the chosen variant (config.mjs): IOS_*, ANDROID_*, ENV_FILE, ENV_KIND, CONFIG_TEAM...
# A project seen for the first time is scanned and saved; perf init shows and edits the result.
load_variant() {
  check_project
  if ! "$NODE" "$TOOL/lib/config.mjs" has --repo "$REPO"; then
    echo "First run for $REPO: scanning the project (perf init shows and edits the result)…"
    "$NODE" "$TOOL/lib/init.mjs" --repo "$REPO" --auto || fail "the scan could not set up the project — run 'perf init' and fill in the missing fields"
  fi
  local assignments
  assignments="$("$NODE" "$TOOL/lib/config.mjs" shell --repo "$REPO" ${VARIANT:+--variant "$VARIANT"})" || exit 1
  eval "$assignments"
  if [[ -n "${ENV_FILE:-}" ]]; then
    [[ -f "$ENV_FILE" ]] || fail "env file of '$VARIANT' not found: $ENV_FILE (perf init to change it)"
    echo "Variant $VARIANT: bundling $(basename "$ENV_FILE")"
    # react-native-config reads its file at build time, in Xcode and Gradle.
    if [[ "$ENV_KIND" == react-native-config ]]; then export ENVFILE="$ENV_FILE"; fi
  fi
}

# Once a day: a short git fetch tells whether perf-tool has a newer version.
check_for_update() {
  [[ -d "$TOOL/.git" ]] || return 0
  local stamp="$HOME/Library/Caches/perf-tool/update-check"
  [[ -f "$stamp" && -z "$(find "$stamp" -mmin +1440 2>/dev/null)" ]] && return 0
  mkdir -p "$(dirname "$stamp")" && touch "$stamp"
  GIT_TERMINAL_PROMPT=0 perl -e 'alarm 5; exec @ARGV' git -C "$TOOL" fetch --quiet origin 2>/dev/null || return 0
  local behind
  behind="$(git -C "$TOOL" rev-list --count 'HEAD..@{u}' 2>/dev/null || echo 0)"
  [[ "$behind" -gt 0 ]] && echo "perf-tool: $behind update(s) available — run 'perf update'" >&2
  return 0
}

# The "== Devices ==" section of `xctrace list devices`: real iPhones/iPads (and this Mac). It ends
# at the next "== … ==" header: "== Devices Offline ==" only exists while a device is offline,
# otherwise "== Simulators ==" follows directly.
xctrace_devices() {
  xcrun xctrace list devices 2>/dev/null | awk '/^== /{on = ($0 == "== Devices ==")} on && !/^== /' || true
}

list_devices() {
  echo "iOS devices:"
  xctrace_devices | grep -E '^.+ \([0-9.]+\) \(' | sed -E 's/ \(([0-9.]+)\) \(.*$/   (iOS \1)/; s/^/  /' || true
  echo "iOS simulators:"
  xcrun simctl list devices available | grep -E '^[[:space:]]+(iPhone|iPad)' | sed -E 's/ \([0-9A-F-]{36}\)//; s/^[[:space:]]+/  /' || true
  if command -v adb >/dev/null 2>&1; then
    echo "Android devices:"
    adb devices -l | tail -n +2 | grep -v '^$' | sed 's/^/  /' || true
  fi
}

# Names of iPhones/iPads connected by cable (paired Wi-Fi devices are listed but not picked).
# With --wifi also the paired Wi-Fi ones, as "name<TAB>cable|Wi-Fi".
connected_ios_devices() {
  local json
  json="$(mktemp)"
  xcrun devicectl list devices --json-output "$json" >/dev/null 2>&1 || true
  "$NODE" -e 'try {
    const wifi = process.argv[2] === "--wifi";
    // mktemp gives no .json extension, so require() would parse the file as JavaScript.
    for (const device of JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")).result.devices) {
      const transport = device.connectionProperties?.transportType;
      if (transport === "wired") console.log(wifi ? `${device.deviceProperties.name}\tcable` : device.deviceProperties.name);
      else if (wifi && transport === "localNetwork") console.log(`${device.deviceProperties.name}\tWi-Fi`);
    }
  } catch {}' "$json" "${1:-}"
  rm -f "$json"
}

# Available iPhone/iPad simulators as "udid<TAB>name<TAB>iOS x.y[, booted]": booted first, then
# iPhones before iPads, then newest iOS.
available_simulators() {
  xcrun simctl list devices available --json 2>/dev/null | "$NODE" -e '
    let input = "";
    process.stdin.on("data", chunk => input += chunk).on("end", () => {
      try {
        const rows = [];
        for (const [runtime, devices] of Object.entries(JSON.parse(input).devices)) {
          const version = runtime.match(/SimRuntime\.iOS-(\d+)-(\d+)/);
          if (!version) continue;
          for (const device of devices)
            if (/^(iPhone|iPad)/.test(device.name))
              rows.push({ ...device, os: `iOS ${version[1]}.${version[2]}`, rank: +version[1] * 1000 + +version[2] });
        }
        const booted = row => row.state === "Booted";
        const iphone = row => row.name.startsWith("iPhone");
        rows.sort((a, b) => booted(b) - booted(a) || iphone(b) - iphone(a) || b.rank - a.rank || a.name.localeCompare(b.name));
        for (const row of rows) console.log([row.udid, row.name, row.os + (booted(row) ? ", booted" : "")].join("\t"));
      } catch {}
    });' || true
}

# Asks which connected iPhone or simulator to run on. Sets DEVICE_NAME; for a simulator also UDID
# and KIND (by UDID, since one simulator name can exist for several iOS versions).
pick_ios_target() {
  local labels=() names=() udids=() udid name info
  while IFS=$'\t' read -r name info; do
    [[ -n "$name" ]] || continue
    labels+=("$(printf '%-28s device, %s' "$name" "$info")"); names+=("$name"); udids+=("")
  done <<<"$(connected_ios_devices --wifi)"
  while IFS=$'\t' read -r udid name info; do
    [[ -n "$udid" ]] || continue
    labels+=("$(printf '%-28s simulator, %s' "$name" "$info")"); names+=("$name"); udids+=("$udid")
  done <<<"$(available_simulators)"
  local count=${#names[@]}
  [[ $count -gt 0 ]] || fail "no iPhone connected by cable and no iOS simulator available (perf devices)"
  echo "Run on:" >&2
  local i
  for ((i = 0; i < count; i++)); do printf '  %2d) %s\n' $((i + 1)) "${labels[$i]}" >&2; done
  local choice
  while true; do
    read -r -p "Choose 1-$count [Enter = 1]: " choice || exit 130
    choice="${choice:-1}"
    [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= count)) && break
    echo "Enter a number from 1 to $count." >&2
  done
  DEVICE_NAME="${names[$((choice - 1))]}"
  if [[ -n "${udids[$((choice - 1))]}" ]]; then UDID="${udids[$((choice - 1))]}"; KIND=simulator; fi
}

# Sets KIND (device|simulator) and UDID for a device or simulator name. Without a name: a menu in
# a terminal, otherwise the one iPhone connected by cable.
resolve_ios_target() {
  local name="$1"
  UDID=""
  if [[ -z "$name" ]]; then
    if [[ -t 0 && -t 2 ]]; then
      pick_ios_target
      [[ -n "$UDID" ]] && return
      name="$DEVICE_NAME"
    else
      local devices
      devices="$(connected_ios_devices)"
      if [[ -n "$devices" && "$(wc -l <<<"$devices")" -eq 1 ]]; then
        name="$devices"
        DEVICE_NAME="$name"
        echo "Using the connected device: $name"
      else
        echo "No single iPhone connected by cable — pass the device or simulator name, e.g. perf ios \"iPhone 16 plus\"" >&2
        list_devices
        exit 1
      fi
    fi
  fi
  UDID="$(xctrace_devices | grep -F "$name (" | head -1 | grep -oE '\([0-9A-Fa-f-]{20,}\)$' | tr -d '()' || true)"
  if [[ -n "$UDID" ]]; then KIND=device; return; fi
  UDID="$(xcrun simctl list devices available | grep -F "    $name (" | sort -r -t'(' -k3 | grep -m1 -oE '[0-9A-F]{8}-([0-9A-F]{4}-){3}[0-9A-F]{12}' || true)"
  if [[ -n "$UDID" ]]; then KIND=simulator; return; fi
  echo "No connected device or simulator named '$name'." >&2
  list_devices
  exit 1
}

server_running() { curl -sf "$DASHBOARD/ping" >/dev/null 2>&1; }

# Team for device signing: --team / PERF_TEAM / PERF_TEAM_<VARIANT>, the team saved on the setup
# page, else the team of a local provisioning profile for the bundle id (the project may leave
# DEVELOPMENT_TEAM empty and rely on each developer's Xcode).
resolve_team() {
  [[ -n "${PERF_TEAM:-}" ]] && { TEAM="$PERF_TEAM"; return; }
  local variant_team
  variant_team="PERF_TEAM_$(tr '[:lower:]' '[:upper:]' <<<"$VARIANT" | tr -c 'A-Z0-9\n' '_')"
  [[ -n "${!variant_team:-}" ]] && { TEAM="${!variant_team}"; return; }
  [[ -n "${CONFIG_TEAM:-}" ]] && { TEAM="$CONFIG_TEAM"; return; }
  TEAM=""
  local profile plist
  plist="$(mktemp)"
  for profile in "$HOME/Library/Developer/Xcode/UserData/Provisioning Profiles/"*.mobileprovision \
    "$HOME/Library/MobileDevice/Provisioning Profiles/"*.mobileprovision; do
    [[ -f "$profile" ]] || continue
    security cms -D -i "$profile" >"$plist" 2>/dev/null || continue
    if [[ "$(plutil -extract Entitlements.application-identifier raw -o - "$plist" 2>/dev/null)" == *".$IOS_BUNDLE" ]]; then
      TEAM="$(plutil -extract TeamIdentifier.0 raw -o - "$plist" 2>/dev/null)"
      break
    fi
  done
  rm -f "$plist"
}

# Starts the dashboard server in the background unless one is already running for this setup.
start_server() {
  local android_package="${1:-}"
  if server_running; then
    local running_android
    running_android="$(curl -sf "$DASHBOARD/status" | sed -nE 's/.*"android":"([^"]+)".*/\1/p')"
    if [[ -z "$android_package" || "$running_android" == "$android_package" ]]; then
      echo "Dashboard already running: $DASHBOARD"
      open "$DASHBOARD"
      return
    fi
    if curl -sf -X POST "$DASHBOARD/android" -H 'Content-Type: application/json' \
      -d "{\"package\":\"$android_package\"}" >/dev/null 2>&1; then
      echo "Dashboard already running: $DASHBOARD (Android sampling switched on for $android_package)"
      open "$DASHBOARD"
      return
    fi
    # An older perf-tool server without that endpoint: stop it (it saves an active recording) and restart.
    local old_pids
    old_pids="$(pgrep -f "$TOOL/lib/server.mjs" || true)"
    [[ -n "$old_pids" ]] || fail "port $PORT is used by another program — free it and retry"
    echo "Restarting the dashboard server with Android sampling…"
    kill -TERM $old_pids 2>/dev/null || true
    for _ in $(seq 1 20); do server_running || break; sleep 0.25; done
  fi
  mkdir -p "$CACHE"
  local args=(--repo "$REPO")
  [[ -n "$android_package" ]] && args+=(--android "$android_package")
  "$NODE" "$TOOL/lib/server.mjs" "${args[@]}" >"$CACHE/server.log" 2>&1 &
  SERVER_PID=$!
  echo "$SERVER_PID" >"$CACHE/server.pid"
  for _ in $(seq 1 20); do server_running && break; sleep 0.25; done
  server_running || { cat "$CACHE/server.log" >&2; fail "dashboard server did not start"; }
  echo "Dashboard: $DASHBOARD"
  open "$DASHBOARD"
  # While this session's server runs, the yarn perf:* scripts are available in package.json.
  "$NODE" "$TOOL/lib/setup.mjs" --repo "$REPO" --quiet || true
}

# The scripts stay only when the project has committed them; otherwise package.json goes back clean.
remove_scripts() {
  git -C "$REPO" show HEAD:package.json 2>/dev/null | grep -qE '"perf:(ios|android|web)' && return
  "$NODE" "$TOOL/lib/setup.mjs" --repo "$REPO" --remove --quiet || true
}

stop_server() {
  [[ -n "${TAIL_PID:-}" ]] && kill "$TAIL_PID" 2>/dev/null || true
  if [[ -n "$SERVER_PID" ]] && kill -0 "$SERVER_PID" 2>/dev/null; then
    kill -TERM "$SERVER_PID" 2>/dev/null || true # the server saves an active recording first
    wait "$SERVER_PID" 2>/dev/null || true
    rm -f "$CACHE/server.pid"
  fi
  [[ -n "$SERVER_PID" ]] && remove_scripts
  return 0
}

# Keeps the dashboard alive in the foreground until Ctrl-C.
follow_server() {
  [[ -n "$SERVER_PID" ]] || return 0
  echo
  echo "Live data: $DASHBOARD   (Ctrl-C stops the server; an active recording is saved)"
  tail -n +1 -f "$CACHE/server.log" &
  local tail_pid=$!
  TAIL_PID=$tail_pid
  wait "$SERVER_PID" 2>/dev/null || true
  kill "$tail_pid" 2>/dev/null || true
}

# Saves the build output to $2 and shows its progress in the terminal and on the dashboard.
build_progress() {
  "$NODE" "$TOOL/lib/build-progress.mjs" --platform "$1" --log "$2" --history "$CACHE/build-history.json" \
    ${SERVER_PID:+--dashboard "$DASHBOARD"}
}

# React Native's react-native-xcode.sh expands BUNDLE_CONFIG unquoted ("--config $BUNDLE_CONFIG"),
# so a path with spaces (the app installs into "Application Support") is split. Hands Xcode a
# space-free symlink instead; Node follows it, so the config's absolute requires are unaffected.
bundle_config_path() {
  local config="$GEN/metro.config.js"
  [[ "$config" =~ [[:space:]] ]] || { echo "$config"; return; }
  local dir="$CACHE"
  if [[ "$dir" =~ [[:space:]] ]]; then
    dir="/tmp/perf-tool-$(id -u)/$(printf '%s' "$NAME" | tr -c 'A-Za-z0-9._-' '_')"
    mkdir -p -m 700 "$(dirname "$dir")"
    [[ -O "$(dirname "$dir")" && ! -L "$(dirname "$dir")" ]] || fail "$(dirname "$dir") is not owned by you — remove it and retry"
  fi
  mkdir -p "$dir"
  ln -sfn "$config" "$dir/metro.config.js"
  echo "$dir/metro.config.js"
}

build_ios() {
  local sdk=$([[ "$KIND" == simulator ]] && echo iphonesimulator || echo iphoneos)
  [[ ! -f "$REPO/ios/Podfile" || -d "$REPO/ios/Pods" ]] || fail "ios/Pods missing — run 'cd ios && pod install' first"
  "$NODE" "$TOOL/lib/prepare.mjs" --repo "$REPO" --out "$GEN" --ios-sdk "$sdk" ${ENV_FILE:+--env-file "$ENV_FILE"}
  mkdir -p "$CACHE"
  local signing=()
  if [[ "$KIND" == device ]]; then
    resolve_team
    if [[ -n "$TEAM" ]]; then
      signing=("DEVELOPMENT_TEAM=$TEAM")
      echo "Signing with team $TEAM"
    fi
  fi
  [[ -n "$IOS_SCHEME" && -n "$IOS_BUNDLE" ]] || fail "variant '$VARIANT' has no iOS settings — perf init to add them"
  local container=(-workspace "$IOS_WORKSPACE")
  [[ "$IOS_WORKSPACE" == *.xcodeproj ]] && container=(-project "$IOS_WORKSPACE")
  echo "Building Release + probe → $DEVICE_NAME ($KIND, $VARIANT, scheme '$IOS_SCHEME'). Log: $CACHE/ios-build.log"
  # Separate DerivedData: probe builds never invalidate or replace the normal build cache.
  local bundle_config
  bundle_config="$(bundle_config_path)"
  BUNDLE_CONFIG="$bundle_config" ENTRY_FILE="$GEN/bundle/index.perf.js" \
    xcodebuild "${container[@]}" -scheme "$IOS_SCHEME" -configuration Release \
    -destination "id=$UDID" -derivedDataPath "$CACHE/ios" -xcconfig "$GEN/perf.xcconfig" \
    -allowProvisioningUpdates "${signing[@]+"${signing[@]}"}" build 2>&1 | build_progress ios "$CACHE/ios-build.log" || true
  if ! grep -q "BUILD SUCCEEDED" "$CACHE/ios-build.log"; then
    grep -q "requires a development team" "$CACHE/ios-build.log" &&
      echo "No signing team found for $IOS_BUNDLE. Pass it: perf ios \"$DEVICE_NAME\" --team <TEAM_ID> (Xcode → Settings → Accounts)." >&2
    grep -q "doesn't include the currently selected device" "$CACHE/ios-build.log" &&
      echo "This device ($UDID) is not registered in the ${TEAM:-team}'s profile for $IOS_BUNDLE. Sign in to that team in Xcode → Settings → Accounts so Xcode can register it, ask a team admin to add the UDID, or use a registered device." >&2
    grep -q "No Accounts" "$CACHE/ios-build.log" &&
      echo "Xcode has no Apple ID signed in (Xcode → Settings → Accounts); without it new devices cannot be added to profiles." >&2
    fail "build failed, see $CACHE/ios-build.log"
  fi

  local app="" candidate
  for candidate in "$CACHE/ios/Build/Products/Release-$sdk/"*.app; do
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$candidate/Info.plist" 2>/dev/null)" == "$IOS_BUNDLE" ]]; then app="$candidate"; fi
  done
  [[ -n "$app" ]] || fail "built app for $IOS_BUNDLE not found"
  # Projects whose domains share one boot splash: this domain's splash goes into the built app.
  if [[ -n "$IOS_SPLASH_SCRIPT" ]]; then
    PERF_NODE="$NODE" "$TOOL/lib/ios-splash.sh" "$REPO" "$IOS_SPLASH_SCRIPT" "$app" \
      "$(/usr/libexec/PlistBuddy -c 'Print MinimumOSVersion' "$app/Info.plist")" || fail "could not switch the boot splash ($IOS_SPLASH_SCRIPT)"
  fi
  if [[ "$KIND" == simulator ]]; then
    xcrun simctl boot "$UDID" 2>/dev/null || true
    open -a Simulator
    xcrun simctl install "$UDID" "$app"
    xcrun simctl launch --terminate-running-process "$UDID" "$IOS_BUNDLE" >/dev/null
  else
    xcrun devicectl device install app --device "$UDID" "$app" >/dev/null
    xcrun devicectl device process launch --device "$UDID" --terminate-existing "$IOS_BUNDLE" >/dev/null
  fi
  echo "Probe build installed and launched on $DEVICE_NAME."
  # Lets the dashboard's automatic before/after runs drive this device.
  if server_running; then
    "$NODE" -e 'console.log(JSON.stringify({ udid: process.argv[1], kind: process.argv[2], bundle: process.argv[3], team: process.argv[4], name: process.argv[5], executable: process.argv[6] }))' \
      "$UDID" "$KIND" "$IOS_BUNDLE" "${TEAM:-}" "$DEVICE_NAME" "$(/usr/libexec/PlistBuddy -c 'Print CFBundleExecutable' "$app/Info.plist" 2>/dev/null || true)" |
      curl -sf -X POST "$DASHBOARD/ios" -H 'Content-Type: application/json' -d @- >/dev/null || true
  fi
}

# Android runs over adb on Wi-Fi by default, so the host-side sampling (threads, frames, GC, memory,
# temperature), the install and Auto replays keep working without a cable. `perf android` lists the
# phones it can use: on the cable (switched to adb over TCP, then reached by its Wi-Fi address),
# already connected over Wi-Fi, used before (saved), or announcing Android 11+ Wireless debugging.
ANDROID_SAVED="$HOME/Library/Caches/perf-tool/android-devices" # "address<TAB>model", newest first
is_wireless_serial() { [[ "$1" == *:* || "$1" == *._adb-tls-connect.* ]]; }
adb_serials() { adb devices | awk 'NR > 1 && $2 == "device" { print $1 }'; }
android_model() { adb -s "$1" shell getprop ro.product.model 2>/dev/null | tr -d '\r' || true; }

# Connects an address and waits until adb sees the phone. Returns 1 when it does not answer.
connect_adb_address() {
  local address="$1"
  for _ in 1 2 3 4 5; do
    [[ "$address" == *:* ]] && { adb connect "$address" >/dev/null 2>&1 || true; }
    [[ "$(adb -s "$address" get-state 2>/dev/null || true)" == "device" ]] && return 0
    sleep 1
  done
  return 1
}

save_android_device() {
  local address="$1" model="$2"
  mkdir -p "$(dirname "$ANDROID_SAVED")"
  { printf '%s\t%s\n' "$address" "$model"; grep -v -F "$address"$'\t' "$ANDROID_SAVED" 2>/dev/null || true; } | head -8 >"$ANDROID_SAVED.tmp"
  mv "$ANDROID_SAVED.tmp" "$ANDROID_SAVED"
}

# Phones to choose from, as "kind<TAB>serial or address<TAB>model<TAB>note".
android_candidates() {
  local serial model address name seen=" "
  while read -r serial; do
    [[ -n "$serial" ]] || continue
    model="$(android_model "$serial")"
    if is_wireless_serial "$serial"; then printf 'wifi\t%s\t%s\tWi-Fi, connected\n' "$serial" "$model"
    elif [[ "$serial" == emulator-* ]]; then printf 'emulator\t%s\t%s\temulator\n' "$serial" "$model"
    else printf 'cable\t%s\t%s\tcable, switches to Wi-Fi\n' "$serial" "$model"; fi
    seen+="$serial "
  done <<<"$(adb_serials || true)"
  while IFS=$'\t' read -r address model; do
    [[ -n "$address" && "$seen" != *" $address "* ]] || continue
    printf 'saved\t%s\t%s\tWi-Fi, %s (used before)\n' "$address" "$model" "$address"
    seen+="$address "
  done < <(cat "$ANDROID_SAVED" 2>/dev/null || true)
  while read -r name address; do
    # A paired phone adb already connected through Wireless debugging is listed as name._adb-tls-connect…
    [[ -n "$address" && "$seen" != *" $address "* && "$seen" != *" $name."* ]] || continue
    printf 'mdns\t%s\t%s\tWi-Fi, %s (Wireless debugging)\n' "$address" "$name" "$address"
  done <<<"$(adb mdns services 2>/dev/null | awk '/_adb-tls-connect/ { print $1, $NF }' || true)"
}

# Switches a phone on the cable to adb over Wi-Fi. Stays on the cable when the phone has no Wi-Fi
# address or the Mac cannot reach it.
android_cable_to_wifi() {
  local serial="$1" model="$2" ip
  ip="$(adb -s "$serial" shell ip -f inet addr show wlan0 2>/dev/null | awk '/inet / { sub(/\/.*/, "", $2); print $2; exit }' || true)"
  if [[ -z "$ip" ]]; then
    echo "The phone is not on Wi-Fi: staying on the cable." >&2
    export ANDROID_SERIAL="$serial"
    return
  fi
  echo "Switching ${model:-$serial} to adb over Wi-Fi ($ip:5555)…"
  adb -s "$serial" tcpip 5555 >/dev/null
  sleep 2
  if connect_adb_address "$ip:5555"; then
    export ANDROID_SERIAL="$ip:5555"
    save_android_device "$ANDROID_SERIAL" "$model"
    echo "adb over Wi-Fi: $ANDROID_SERIAL — the cable can be unplugged."
  else
    echo "This Mac cannot reach the phone at $ip (another network?): staying on the cable." >&2
    export ANDROID_SERIAL="$serial"
  fi
}

use_android_device() {
  local kind="$1" serial="$2" model="$3"
  case "$kind" in
    cable) android_cable_to_wifi "$serial" "$model" ;;
    emulator) export ANDROID_SERIAL="$serial" ;;
    *)
      connect_adb_address "$serial" ||
        fail "could not reach ${model:-$serial} at $serial. It must be on the same Wi-Fi as this Mac; after a phone restart connect the cable once (Android 11+: or pair it under Developer options → Wireless debugging with 'adb pair')"
      export ANDROID_SERIAL="$serial"
      model="${model:-$(android_model "$serial")}"
      [[ "$serial" == *:* ]] && save_android_device "$serial" "$model"
      echo "Using ${model:-$serial} over Wi-Fi ($serial)."
      ;;
  esac
}

# Sets ANDROID_SERIAL. A serial or address passed on the command line is used as is (a cable
# serial is switched to Wi-Fi); otherwise a menu in a terminal, or the only phone there is.
resolve_android_target() {
  local given="${1:-}"
  if [[ -n "$given" ]]; then
    if is_wireless_serial "$given"; then use_android_device wifi "$given" ""
    elif [[ "$given" == emulator-* ]]; then use_android_device emulator "$given" ""
    else use_android_device cable "$given" "$(android_model "$given")"; fi
    return
  fi
  local kinds=() serials=() models=() labels=() kind serial model note
  while IFS=$'\t' read -r kind serial model note; do
    [[ -n "$kind" ]] || continue
    kinds+=("$kind"); serials+=("$serial"); models+=("$model")
    labels+=("$(printf '%-24s %s' "${model:-$serial}" "$note")")
  done <<<"$(android_candidates)"
  local count=${#kinds[@]}
  ((count > 0)) || fail "no Android phone found: connect it by cable once (it is then switched to Wi-Fi), or pair it under Developer options → Wireless debugging ('adb pair')"
  local choice=1
  if [[ -t 0 && -t 2 ]]; then
    echo "Run on:" >&2
    local i
    for ((i = 0; i < count; i++)); do printf '  %2d) %s\n' $((i + 1)) "${labels[$i]}" >&2; done
    while true; do
      read -r -p "Choose 1-$count [Enter = 1]: " choice || exit 130
      choice="${choice:-1}"
      [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= count)) && break
      echo "Enter a number from 1 to $count." >&2
    done
  elif ((count > 1)); then
    printf '  %s\n' "${labels[@]}" >&2
    fail "several Android phones: pass the serial or address, e.g. perf android ${serials[0]}"
  fi
  use_android_device "${kinds[$((choice - 1))]}" "${serials[$((choice - 1))]}" "${models[$((choice - 1))]}"
}

build_android() {
  "$NODE" "$TOOL/lib/prepare.mjs" --repo "$REPO" --out "$GEN" ${ENV_FILE:+--env-file "$ENV_FILE"}
  [[ -n "$ANDROID_PACKAGE" ]] || fail "variant '$VARIANT' has no Android settings — perf init to add them"
  echo "Building Android release + probe ($VARIANT, ${ANDROID_FLAVOR:+$ANDROID_FLAVOR }Release). Log: $CACHE/android-build.log"
  mkdir -p "$CACHE"
  (cd "$REPO/android" && ./gradlew -I "$GEN/init.gradle" --console=rich "install${ANDROID_FLAVOR}Release" 2>&1) |
    build_progress android "$CACHE/android-build.log" || fail "build failed, see $CACHE/android-build.log"
  adb shell monkey -p "$ANDROID_PACKAGE" -c android.intent.category.LAUNCHER 1 >/dev/null
  echo "Probe build installed and launched. The next normal release build re-bundles without the probe."
}

# ---------- web (perf web) ----------

json_post() { # path json
  curl -sf -X POST "$DASHBOARD$1" -H 'Content-Type: application/json' -d "$2"
}

json_of() { # name value [name value …] → {"name":"value",…}
  "$NODE" -e 'const a = process.argv.slice(1); const o = {}; for (let i = 0; i < a.length; i += 2) o[a[i]] = a[i + 1]; console.log(JSON.stringify(o))' "$@"
}

# The dashboard server for perf web; a running one is reused and switched to this project.
start_web_server() { # [--choose]
  if server_running; then
    if [[ "${1:-}" != "--choose" ]]; then
      json_post /project "$(json_of repo "$REPO")" >/dev/null ||
        fail "the dashboard on port $PORT is from an older perf-tool (or another program): stop it and retry"
    fi
    echo "Dashboard already running: $DASHBOARD"
    open "$DASHBOARD"
    return
  fi
  local log="$HOME/Library/Caches/perf-tool/server.log"
  local args=()
  if [[ "${1:-}" == "--choose" ]]; then
    args=(--choose)
  else
    mkdir -p "$CACHE"
    log="$CACHE/server.log"
    args=(--repo "$REPO")
  fi
  mkdir -p "$(dirname "$log")"
  "$NODE" "$TOOL/lib/server.mjs" "${args[@]}" >"$log" 2>&1 &
  SERVER_PID=$!
  for _ in $(seq 1 40); do server_running && break; sleep 0.25; done
  server_running || { cat "$log" >&2; fail "dashboard server did not start"; }
  echo "Dashboard: $DASHBOARD"
  open "$DASHBOARD"
  [[ "${1:-}" == "--choose" ]] || "$NODE" "$TOOL/lib/setup.mjs" --repo "$REPO" --quiet || true
}

# perf web outside a project: the dashboard lists the saved web projects (or a folder to scan).
choose_project_on_dashboard() {
  echo "No React project in $REPO: choose one on the dashboard ($DASHBOARD)."
  start_web_server --choose
  local choice=""
  while [[ -z "$choice" ]]; do
    if [[ -n "$SERVER_PID" ]] && ! kill -0 "$SERVER_PID" 2>/dev/null; then fail "the dashboard stopped"; fi
    choice="$(curl -sf "$DASHBOARD/project/choice?take=1" | "$NODE" -e '
      let s = ""; process.stdin.on("data", c => (s += c)).on("end", () => {
        try { const j = JSON.parse(s); if (j.repo) console.log(`${j.repo}\t${j.variant || ""}`); } catch {}
      });' || true)"
    [[ -n "$choice" ]] || sleep 1
  done
  use_repo "${choice%%$'\t'*}"
  [[ -z "$VARIANT" ]] && VARIANT="${choice#*$'\t'}"
  echo "Project: $REPO${VARIANT:+ ($VARIANT)}"
}

# perf web without --variant in a Terminal, for a project with several variants (brands ×
# environments): a menu, the default first; Enter starts the default.
pick_web_variant() {
  [[ -z "$VARIANT" && -t 0 && -t 2 ]] || return 0
  "$NODE" "$TOOL/lib/config.mjs" has --repo "$REPO" || return 0
  local ids=() labels=() id env mark
  while IFS=$'\t' read -r id env mark; do
    [[ -n "$id" ]] || continue
    if [[ "$mark" == default ]]; then
      ids=("$id" "${ids[@]+"${ids[@]}"}"); labels=("$(printf '%-22s %s  (default)' "$id" "$env")" "${labels[@]+"${labels[@]}"}")
    else
      ids+=("$id"); labels+=("$(printf '%-22s %s' "$id" "$env")")
    fi
  done <<<"$("$NODE" "$TOOL/lib/config.mjs" variants --repo "$REPO")"
  local count=${#ids[@]}
  [[ $count -gt 1 ]] || return 0
  echo "Start which variant?" >&2
  local i
  for ((i = 0; i < count; i++)); do printf '  %2d) %s\n' $((i + 1)) "${labels[$i]}" >&2; done
  local choice
  while true; do
    read -r -p "Choose 1-$count [Enter = 1]: " choice || exit 130
    choice="${choice:-1}"
    [[ "$choice" =~ ^[0-9]+$ ]] && ((choice >= 1 && choice <= count)) && break
    echo "Enter a number from 1 to $count." >&2
  done
  VARIANT="${ids[$((choice - 1))]}"
}

lan_addresses() {
  "$NODE" -e 'const os = require("os"); for (const list of Object.values(os.networkInterfaces())) for (const item of list ?? []) if (item.family === "IPv4" && !item.internal) console.log(item.address)'
}

stop_web() {
  if [[ -n "$DEV_PID" ]] && kill -0 "$DEV_PID" 2>/dev/null; then
    kill -TERM "$DEV_PID" 2>/dev/null || true
    for _ in $(seq 1 20); do kill -0 "$DEV_PID" 2>/dev/null || break; sleep 0.25; done
    kill -KILL "$DEV_PID" 2>/dev/null || true
  fi
  DEV_PID=""
}

# Production build with the probe, served on the app's port (webpack-dev-server with the project's own
# devServer settings, or vite preview). Runs until Ctrl-C or the dashboard's Stop.
serve_web() { # chrome|android|none
  local target="$1"
  [[ "$PROJECT_KIND" == web ]] || fail "$REPO is set up as a React Native project: use perf ios / perf android (or perf init to change it)"
  local port="${WEB_PORT_ARG:-$WEB_PORT}"
  # The app is built and served by the project's own Node (nvm), like its normal builds.
  local project_node
  project_node="$(command -v node || echo "$NODE")"
  "$NODE" "$TOOL/lib/prepare-web.mjs" --repo "$REPO" --out "$GEN" --cache "$CACHE" --variant "$VARIANT" --port "$port" ||
    fail "could not prepare the probe build"
  local out_dir="$CACHE/web-build/$(printf '%s' "$VARIANT" | tr -c 'A-Za-z0-9._-' '_')"
  if server_running; then
    json_post /web "$(json_of repo "$REPO" variant "$VARIANT" port "$port" bundler "$WEB_BUNDLER" probe "$GEN/web/perf-probe.js" outDir "$out_dir")" >/dev/null ||
      echo "perf: the dashboard did not accept the web app (older server?)" >&2
  fi
  local log="$CACHE/web-build.log"
  mkdir -p "$CACHE"
  : >"$log"
  echo "Building $WEB_BUNDLER production + probe ($VARIANT) on port $port. Log: $log"
  (
    cd "$REPO" || exit 1
    eval "$WEB_ENV_EXPORTS"
    # A probe build must never upload a release or source maps.
    unset SENTRY_AUTH_TOKEN
    case "$WEB_BUNDLER" in
      vite)
        "$project_node" node_modules/vite/bin/vite.js build --config "$GEN/vite.perf.config.mjs" ${WEB_MODE:+--mode "$WEB_MODE"} ||
          { echo "[perf-progress] failed"; exit 1; }
        echo "[perf-progress] done"
        exec "$project_node" node_modules/vite/bin/vite.js preview --config "$GEN/vite.perf.config.mjs" ${WEB_MODE:+--mode "$WEB_MODE"}
        ;;
      *)
        [[ -f node_modules/webpack-cli/bin/cli.js ]] || { echo "webpack-cli is not installed in $REPO"; echo "[perf-progress] failed"; exit 1; }
        exec "$project_node" node_modules/webpack-cli/bin/cli.js serve --config "$GEN/webpack.perf.config.js" --mode production
        ;;
    esac
  ) > >(build_progress web "$log") 2>&1 &
  DEV_PID=$!
  until grep -qE '^\[perf-progress\] (done|failed)' "$log" 2>/dev/null; do
    kill -0 "$DEV_PID" 2>/dev/null || fail "the build stopped, see $log"
    sleep 1
  done
  grep -q '^\[perf-progress\] failed' "$log" && fail "build failed, see $log"
  local url
  url="$(grep -oE '(Loopback|Local):[[:space:]]+https?://[^[:space:]]+' "$log" | head -1 | grep -oE 'https?://[^[:space:]]+' || true)"
  url="${url:-http://localhost:$port/}"
  url="${url/127.0.0.1/localhost}"
  echo
  echo "App on this Mac:      $url"
  local address
  for address in $(lan_addresses); do echo "Phones on this Wi-Fi: ${url/localhost/$address}"; done
  echo "Dashboard:            $DASHBOARD"
  if [[ "$target" != none ]] && server_running; then
    json_post /web/open "$(json_of target "$target" url "$url")" >/dev/null || echo "perf: could not open the browser (see the dashboard log)" >&2
  fi
  echo "Ctrl-C (or Stop on the dashboard) stops the app and the dashboard."
  while kill -0 "$DEV_PID" 2>/dev/null; do
    if [[ -n "$SERVER_PID" ]] && ! kill -0 "$SERVER_PID" 2>/dev/null; then
      echo "Dashboard stopped."
      break
    fi
    sleep 1
  done
}

command="${1:-help}"
shift || true
with_server=1
android_cable=0
positional=()
expect_team=0
expect_variant=0
expect_repo=0
expect_port=0
VARIANT=""
WEB_PORT_ARG=""
for arg in "$@"; do
  if [[ $expect_team == 1 ]]; then PERF_TEAM="$arg"; expect_team=0
  elif [[ $expect_variant == 1 ]]; then VARIANT="$arg"; expect_variant=0
  elif [[ $expect_repo == 1 ]]; then use_repo "$arg"; expect_repo=0
  elif [[ $expect_port == 1 ]]; then WEB_PORT_ARG="$arg"; expect_port=0
  elif [[ "$arg" == "--team" ]]; then expect_team=1
  elif [[ "$arg" == "--variant" || "$arg" == "--brand" ]]; then expect_variant=1
  elif [[ "$arg" == "--repo" ]]; then expect_repo=1
  elif [[ "$arg" == "--port" ]]; then expect_port=1
  elif [[ "$arg" == "--no-server" ]]; then with_server=0
  elif [[ "$arg" == "--cable" ]]; then android_cable=1
  else positional+=("$arg"); fi
done
set -- "${positional[@]+"${positional[@]}"}"

case "$command" in
  ios)
    require xcrun xcodebuild
    check_for_update
    load_variant
    DEVICE_NAME="${1:-}"
    resolve_ios_target "$DEVICE_NAME"
    trap stop_server EXIT
    trap 'exit 130' INT TERM
    [[ $with_server == 1 ]] && start_server
    build_ios
    follow_server
    ;;

  android)
    require adb
    check_for_update
    load_variant
    # ANDROID_SERIAL: adb, the Gradle install and the server all honour it.
    if [[ $android_cable == 1 ]]; then
      [[ -n "${1:-}" ]] && export ANDROID_SERIAL="$1"
    else
      resolve_android_target "${1:-}"
    fi
    adb get-state >/dev/null 2>&1 || fail "no Android device connected (or several: pass the serial, see 'perf devices')"
    trap stop_server EXIT
    trap 'exit 130' INT TERM
    [[ $with_server == 1 ]] && start_server "$ANDROID_PACKAGE"
    build_android
    follow_server
    ;;

  web)
    require
    check_for_update
    web_target="${1:-chrome}"
    [[ "$web_target" =~ ^(chrome|android|none)$ ]] || fail "perf web [chrome|android|none] — '$web_target' is not one of them"
    if [[ "$web_target" == android ]]; then command -v adb >/dev/null 2>&1 || fail "'adb' is required for perf web android (Android platform-tools)"; fi
    trap 'stop_web; stop_server' EXIT
    trap 'exit 130' INT TERM
    if [[ ! -f "$REPO/package.json" ]] || ! grep -q '"react"' "$REPO/package.json"; then
      choose_project_on_dashboard
    else
      # A project seen for the first time is scanned and saved before the menu can list its variants.
      if [[ -f "$REPO/package.json" ]] && ! "$NODE" "$TOOL/lib/config.mjs" has --repo "$REPO"; then
        echo "First run for $REPO: scanning the project (perf init shows and edits the result)…"
        "$NODE" "$TOOL/lib/init.mjs" --repo "$REPO" --auto || fail "the scan could not set up the project — run 'perf init' and fill in the missing fields"
      fi
      pick_web_variant
      [[ $with_server == 1 ]] && start_web_server
    fi
    load_variant
    if [[ "$PROJECT_KIND" == web && -n "$SERVER_PID" ]] && ! server_running; then fail "dashboard server stopped"; fi
    serve_web "$web_target"
    ;;

  health)
    require
    check_project
    stats="$(ls -t "$CACHE"/web-build/*/perf-stats.json 2>/dev/null | head -1 || true)"
    exec "$NODE" "$TOOL/lib/code-health.mjs" --repo "$REPO" ${stats:+--stats "$stats"} "$@"
    ;;

  devices)
    list_devices
    ;;

  init)
    require
    exec "$NODE" "$TOOL/lib/init.mjs" --repo "$REPO" "$@"
    ;;

  update)
    [[ -d "$TOOL/.git" ]] || fail "$TOOL is not a git clone; reinstall it from the Perf Tool app or git"
    git -C "$TOOL" pull --ff-only
    ;;

  setup)
    require
    check_project
    exec "$NODE" "$TOOL/lib/setup.mjs" --repo "$REPO" "$@"
    ;;

  server)
    require
    check_project
    if [[ "${1:-}" == "android" ]]; then
      load_variant
      exec "$NODE" "$TOOL/lib/server.mjs" --repo "$REPO" --android "$ANDROID_PACKAGE"
    fi
    exec "$NODE" "$TOOL/lib/server.mjs" --repo "$REPO"
    ;;

  compiler)
    require
    check_project
    exec "$NODE" "$TOOL/lib/compiler-report.mjs" --repo "$REPO" "$@"
    ;;

  ios-trace)
    require xcrun
    load_variant
    label="${1:?label required, e.g. perf ios-trace home-before \"iPhone 16 plus\"}"
    resolve_ios_target "${2:-}"
    seconds="${3:-60}"
    mkdir -p "$RESULTS_DIR/ios-traces"
    output="$RESULTS_DIR/ios-traces/$(date +%Y-%m-%d_%H-%M-%S)_${label}.trace"
    echo "Recording ${seconds}s. Use the app now; Ctrl-C stops early."
    xcrun xctrace record --template 'Time Profiler' --instrument 'Hitches' \
      --device "$UDID" --time-limit "${seconds}s" --output "$output" --launch -- "$IOS_BUNDLE" || true
    "$NODE" "$TOOL/lib/ios-analyze.mjs" "$output" --process "${IOS_EXECUTABLE:-$IOS_SCHEME}"
    open "$output"
    ;;

  ios-compare)
    exec "$NODE" "$TOOL/lib/ios-analyze.mjs" --compare "$@"
    ;;

  clean)
    rm -rf "$GEN" "$CACHE"
    echo "Removed $GEN and $CACHE"
    ;;

  *)
    usage
    ;;
esac
